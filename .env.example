APP_ENV=development
PORT=8080
DATABASE_DRIVER=sqlite
DATABASE_DSN=securehr.db
# For MySQL: DATABASE_DRIVER=mysql and DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/securehr?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=change-this-development-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=change-me-manager
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=change-me-employee
